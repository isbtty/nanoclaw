# boswell host-tools bridge
BOSWELL_DAEMON_URL=http://localhost:3100
BOSWELL_DAEMON_DEVICE_SECRET=change-me-to-a-random-secret

# boswell: 追加 Slack ワークスペース (ADR-0018)
# サフィックスをカンマ区切りで宣言 (A-Z0-9_ のみ)。各サフィックスにつき
# SLACK_BOT_TOKEN_<SUFFIX> (必須) / SLACK_APP_TOKEN_<SUFFIX> (Socket Mode 推奨) /
# SLACK_SIGNING_SECRET_<SUFFIX> (webhook モード時のみ) を設定する。
# instance 名は slack-<suffix を小文字化し _→- 変換> (例: ACME → slack-acme)。
# プライマリワークスペースは upstream の SLACK_BOT_TOKEN 等 (instance=slack) のまま。
# DESHI_SLACK_WORKSPACES=ACME,CLIENT_B
# SLACK_BOT_TOKEN_ACME=xoxb-...
# SLACK_APP_TOKEN_ACME=xapp-...
# SLACK_SIGNING_SECRET_ACME=...
